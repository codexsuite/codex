{
  "compilerOptions": {
    "target": "ES2022",
    // No DOM: the core also runs in React Native (#35). WebWorker supplies the web platform the core may use (fetch,
    // AbortSignal, FormData, TextDecoder, crypto); eslint.config.js bans the worker-only globals.
    "lib": ["ES2022", "WebWorker"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": [],
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "strict": true,
    "resolveJsonModule": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"]
}
